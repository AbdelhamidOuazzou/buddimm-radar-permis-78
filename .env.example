# Copie ce fichier en ".env" (ignoré par git) et remplis les valeurs.
# Ne mets JAMAIS la vraie clé dans ce fichier-ci ni dans le code.
# Toute API compatible OpenAI convient (OpenAI, proxy d'établissement, LiteLLM...).
OPENAI_BASE_URL=https://votre-proxy-ou-api.example/v1
OPENAI_API_KEY=
OPENAI_MODEL=nom-du-modele
